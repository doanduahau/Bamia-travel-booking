# ==========================================
# TravelBaMia - Global GitIgnore Configuration
# ==========================================

# ── SYSTEM & OS FILES ──────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── IDEs & EDITORS ────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.workspace
*.code-workspace
*.iml
*.sublime-project
*.sublime-workspace

# ── ENVIRONMENT & CREDENTIALS (CRITICAL) ────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
travel-backend/.env
travel-frontend/.env

# ── PYTHON (BACKEND) ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
pyvenv.cfg
pip-selfcheck.json

# Django specific
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
travel-backend/static/images/tours/   # Nếu upload động không muốn đẩy lên
*.log

# ── NODE.JS & FRONTEND ────────────────────
node_modules/
/travel-frontend/node_modules/
/travel-frontend/dist/
/travel-frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache
.vite/
